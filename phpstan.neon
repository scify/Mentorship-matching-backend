includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Levels 0-5 are fully clean and must stay clean.
    # phpstan-baseline.neon freezes the pre-existing level 6 missing-type errors
    # and 23 reviewed level 8 findings: false positives (Auth::user() behind the
    # auth middleware, withTrashed() relations, json_encode()) and missing input
    # validation, where an unknown id from a request reaches find() or first().
    # New and changed code must pass level 8.
    # Burn down the baseline over time: remove entries as files get typed,
    # regenerate with: vendor/bin/phpstan analyse --memory-limit=1G --generate-baseline
    level: 8

    paths:
        - app
