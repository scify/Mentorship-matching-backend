{#-
  Staging .env template, rendered by .github/workflows/deploy-staging.yml
  (cuchi/jinja2-action) and copied to the server as .env.staging, which the
  deploy step moves into place as .env.

  Only the DB_* values come from GitHub Secrets. Everything else is a fixed
  value chosen so a test deployment works with no further configuration.
  APP_KEY is deliberately absent: the deploy step reuses the key already on
  the server, or generates one on the first deploy.
-#}
APP_NAME="JobPairs"
APP_ENV=staging
APP_KEY={{ APP_KEY }}
# Errors render as a plain 500 page rather than a stack trace that would leak
# env values. Flip to true (and re-run the deploy) when debugging staging.
APP_DEBUG=false
APP_LOG_LEVEL=debug
# Only affects absolute URLs in generated email links (accept/decline session
# links included). Set STAGING_APP_URL in the workflow once the domain exists.
APP_URL={{ APP_URL | default('http://localhost', true) }}
SESSION_DOMAIN=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST={{ DB_HOST | default('127.0.0.1', true) }}
DB_PORT={{ DB_PORT | default('3306', true) }}
DB_DATABASE={{ DB_DATABASE }}
DB_USERNAME={{ DB_USERNAME }}
DB_PASSWORD={{ DB_PASSWORD }}

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
# The scheduler runs `queue:work --stop-when-empty` every two minutes; the
# jobs/failed_jobs tables back this connection.
QUEUE_CONNECTION=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No SMTP credentials yet: notifications are written to storage/logs/laravel.log
# instead of being sent. This keeps the session state machine working - with an
# unreachable SMTP host every status change would throw instead. Switch to
# MAIL_MAILER=smtp and fill in the MAIL_* values when a mail server is known.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@job-pairs.gr
MAIL_FROM_NAME=Jobpairs
EMAIL_FOR_CC=testing@email.test

MENTORS_EXCEL_FILE_PATH=../resources/excel/mentors.csv
MENTEES_EXCEL_FILE_PATH=../resources/excel/mentees.csv

# Sentry is disabled while no DSN is set - the keys are left out entirely
# rather than set empty. To enable, add both back:
#   SENTRY_LARAVEL_DSN=https://...
#   MIX_SENTRY_DSN_PUBLIC="${SENTRY_LARAVEL_DSN}"
